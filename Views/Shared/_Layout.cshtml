<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FragranceInfo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    var onCatalogue = controller == "Fragrances" && action != "Create";
    var onCreate = controller == "Fragrances" && action == "Create";
    var onAdvisor = controller == "Advisor";
}
<body>
    <header class="site-header">
        <div class="container site-header-inner">
            <a class="wordmark" asp-controller="Fragrances" asp-action="Index">FragranceInfo</a>
            <nav class="site-nav" aria-label="Main">
                <a class="@(onCatalogue ? "active" : null)" aria-current="@(onCatalogue ? "page" : null)"
                   asp-controller="Fragrances" asp-action="Index">Fragrances</a>
                <a class="@(onCreate ? "active" : null)" aria-current="@(onCreate ? "page" : null)"
                   asp-controller="Fragrances" asp-action="Create">Add fragrance</a>
                <a class="@(onAdvisor ? "active" : null)" aria-current="@(onAdvisor ? "page" : null)"
                   asp-controller="Advisor" asp-action="Index">AI advisor</a>
            </nav>
        </div>
    </header>

    <main role="main" class="container site-main">
        @if (TempData["Message"] is string message)
        {
            <div class="flash" role="status">@message</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">FragranceInfo, ST2 2026, Team 12</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
