@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Something went wrong</h1>
        <p class="page-lead">The page could not be loaded. Go back to the fragrances and try again.</p>
    </div>
</div>

<a asp-controller="Fragrances" asp-action="Index" class="btn btn-primary">Back to fragrances</a>

@if (Model.ShowRequestId)
{
    <p class="mt-4 text-muted small">Request ID: <code>@Model.RequestId</code></p>
}
