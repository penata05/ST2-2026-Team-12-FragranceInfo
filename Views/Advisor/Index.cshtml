@model AdvisorViewModel
@{
    ViewData["Title"] = "AI advisor";
    string[] suggestions =
    [
        "Fresh and light for summer days",
        "Something warm and sweet for winter evenings",
        "A unisex scent I can wear to the office",
    ];
}

<div class="page-head">
    <div>
        <h1 class="page-title">AI advisor</h1>
        <p class="page-lead">Describe what you like, and Gemini picks up to three fragrances from the catalogue.</p>
    </div>
</div>

<div class="advisor">
    @if (!Model.IsConfigured)
    {
        <div class="notice notice-warning">
            The AI advisor is not set up yet. Add a Gemini API key as described in README.md, then restart the application.
        </div>
    }

    <form asp-action="Index" method="post" id="advisor-form" class="panel">
        <label asp-for="Question" class="form-label"></label>
        <textarea asp-for="Question" class="form-control" rows="3"
                  placeholder="Something fresh for summer that I can wear to the office"></textarea>
        <span asp-validation-for="Question" class="text-danger"></span>

        <div class="suggestions">
            <span>Try:</span>
            @foreach (var suggestion in suggestions)
            {
                <button type="button" class="suggestion">@suggestion</button>
            }
        </div>

        <div class="form-actions">
            <button type="submit" id="ask-button" class="btn btn-primary" disabled="@(!Model.IsConfigured)">Ask Gemini</button>
        </div>
    </form>

    @if (Model.Error != null)
    {
        <div class="notice notice-error" role="alert">@Model.Error</div>
    }

    @if (Model.Answer != null)
    {
        <section class="panel answer" aria-live="polite">
            <h2 class="answer-title">Gemini suggests</h2>
            <p class="answer-text">@Model.Answer</p>
        </section>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.suggestion').forEach(function (button) {
            button.addEventListener('click', function () {
                var question = document.getElementById('Question');
                question.value = button.textContent;
                question.focus();
            });
        });

        document.getElementById('advisor-form').addEventListener('submit', function () {
            var button = document.getElementById('ask-button');
            button.disabled = true;
            button.textContent = 'Asking Gemini...';
        });
    </script>
}
