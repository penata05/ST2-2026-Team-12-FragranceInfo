@model AdvisorViewModel
@{
    ViewData["Title"] = "AI advisor";
}

<h1 class="h3 mb-1">AI advisor</h1>
<p class="text-muted mb-4">Describe what you like and get recommendations from the fragrances in the catalogue.</p>

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">
        The AI advisor is not set up yet. Add a Gemini API key as described in README.md, then restart the application.
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Index" method="post" id="advisor-form">
            <div class="mb-3">
                <label asp-for="Question" class="form-label"></label>
                <textarea asp-for="Question" class="form-control" rows="3"
                          placeholder="Something fresh for summer that I can wear to the office"></textarea>
                <span asp-validation-for="Question" class="text-danger"></span>
            </div>
            <button type="submit" id="ask-button" class="btn btn-primary" disabled="@(!Model.IsConfigured)">Ask</button>
        </form>

        @if (Model.Error != null)
        {
            <div class="alert alert-danger mt-4">@Model.Error</div>
        }

        @if (Model.Answer != null)
        {
            <div class="ai-answer mt-4">
                <div class="small text-muted mb-2">Answer from Gemini</div>
                <div class="ai-answer-text">@Model.Answer</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('advisor-form').addEventListener('submit', function () {
            var button = document.getElementById('ask-button');
            button.disabled = true;
            button.textContent = 'Thinking...';
        });
    </script>
}
