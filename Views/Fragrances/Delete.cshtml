@model Fragrance
@{
    ViewData["Title"] = "Delete fragrance";
}

<h1 class="h3 mb-3">Delete fragrance</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="alert alert-warning">Are you sure you want to delete this fragrance?</div>

        <dl class="row mb-4">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Brand</dt>
            <dd class="col-sm-8">@Model.Brand</dd>

            <dt class="col-sm-4">Release year</dt>
            <dd class="col-sm-8">@(Model.ReleaseYear?.ToString() ?? "-")</dd>

            <dt class="col-sm-4">Gender</dt>
            <dd class="col-sm-8">@Model.Gender</dd>

            <dt class="col-sm-4">Concentration</dt>
            <dd class="col-sm-8">@Model.Concentration</dd>

            <dt class="col-sm-4">Main notes</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
