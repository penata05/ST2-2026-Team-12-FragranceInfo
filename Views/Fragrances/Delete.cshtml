@model Fragrance
@{
    ViewData["Title"] = "Delete fragrance";
    ViewData["ShowActions"] = false;
}

<div class="page-head">
    <div>
        <h1 class="page-title">Delete this fragrance?</h1>
        <p class="page-lead">It will be removed from the catalogue permanently.</p>
    </div>
</div>

<div class="panel">
    <partial name="_FragranceRow" model="Model" />
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
    <button type="submit" class="btn btn-danger">Delete fragrance</button>
    <a asp-action="Index" class="btn btn-quiet">Cancel</a>
</form>
