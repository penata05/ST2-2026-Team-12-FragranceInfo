@model Fragrance
@{
    ViewData["Title"] = "Add fragrance";
}

<div class="page-head">
    <h1 class="page-title">Add fragrance</h1>
</div>

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <partial name="_FragranceFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add fragrance</button>
            <a asp-action="Index" class="btn btn-quiet">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
