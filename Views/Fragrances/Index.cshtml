@model FragranceListViewModel
@{
    ViewData["Title"] = "Fragrances";
    var count = Model.Fragrances.Count;
    var summary = Model.Filter.IsActive
        ? $"{count} {(count == 1 ? "fragrance matches" : "fragrances match")} the filter"
        : $"{count} {(count == 1 ? "fragrance" : "fragrances")} in the catalogue";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Fragrances</h1>
        <p class="page-lead">@summary</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add fragrance</a>
</div>

<form asp-action="Index" method="get" class="filter" role="search">
    <div class="filter-name">
        <label for="Name" class="form-label">Name</label>
        <input type="search" id="Name" name="Name" value="@Model.Filter.Name"
               class="form-control" placeholder="Part of the name" />
    </div>
    <div>
        <label for="Brand" class="form-label">Brand</label>
        <select id="Brand" name="Brand" class="form-select">
            <option value="">All brands</option>
            @foreach (var brand in Model.Brands)
            {
                <option value="@brand" selected="@(brand == Model.Filter.Brand)">@brand</option>
            }
        </select>
    </div>
    <div>
        <label for="Gender" class="form-label">Gender</label>
        <select id="Gender" name="Gender" class="form-select">
            <option value="">All</option>
            @foreach (var gender in Fragrance.Genders)
            {
                <option value="@gender" selected="@(gender == Model.Filter.Gender)">@gender</option>
            }
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        @if (Model.Filter.IsActive)
        {
            <a asp-action="Index" class="btn btn-quiet">Clear filter</a>
        }
    </div>
</form>

@if (count == 0)
{
    <div class="empty">
        @if (Model.Filter.IsActive)
        {
            <p class="empty-title">No fragrances match this filter.</p>
            <p class="page-lead">Try part of the name only, or a different brand or gender.</p>
        }
        else
        {
            <p class="empty-title">The catalogue is empty.</p>
            <a asp-action="Create" class="btn btn-primary">Add the first fragrance</a>
        }
    </div>
}
else
{
    <ul class="fragrance-list">
        @foreach (var fragrance in Model.Fragrances)
        {
            <li>
                <partial name="_FragranceRow" model="fragrance" />
            </li>
        }
    </ul>
}
